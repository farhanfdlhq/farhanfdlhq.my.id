# Salin menjadi .env.production (server) atau .env.local (komputer sendiri).

# Alamat situs, tanpa garis miring di akhir
SITE_URL=https://farhanfdlhq.my.id

# Folder data: database SQLite, gambar, dan file CV. Folder /data/ diabaikan git.
# Di komputer sendiri cukup hapus baris ini (bawaan: ./data).
DATA_DIR=/opt/farhanfdlhq/data

# Port aplikasi (aaPanel dan Nginx meneruskan ke sini)
PORT=3300
